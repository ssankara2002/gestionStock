generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENTREPRISE (multi-tenant)
// ─────────────────────────────────────────────

model Entreprise {
  id          Int      @id @default(autoincrement())
  nom         String
  email       String?   @unique
  tel         String?
  adresse     String?
  logo        String?
  histoire         String?
  mission         String?
  vision         String?
  valeur         String?
  geolocalisation         String?
  jourouverture         String[]
  heureouverture         String[]
  jourfermeture         String[]
  heurefermeture        String[]


  // Données dynamiques page d'accueil
  heroTitre         String  @default("Bienvenue")
  heroSousTitre     String  @default("Gérez votre stock efficacement")
  heroImage         String?

  facebook          String?
  instagram         String?
  twitter           String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users              User[]
  roles              Role[]
  userEntreprises    UserEntreprise[]
  produits           Produit[]
  fournisseurs       Fournisseur[]
  approvisionnements Approvisionnement[]
  commandes          Commande[]
  contacts           Contact[]
  matierePremieres   MatierePremiere[]
  transactions       Transaction[]
  transferts         TransfertStock[]
  sessionsInventaire SessionInventaire[]
}

// ─────────────────────────────────────────────
// UTILISATEURS & ACCÈS
// ─────────────────────────────────────────────

model User {
  id                   Int        @id @default(autoincrement())
  nom                  String
  prenom               String
  email                String?
  tel                  String?
  adresse              String
  image                String?
  password             String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  roleId               Int?
  entrepriseId         Int?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  role                 Role?      @relation(fields: [roleId], references: [id])
  entreprise           Entreprise? @relation(fields: [entrepriseId], references: [id])
  employe              Employe?
  commandes            Commande[]
  entreprises          UserEntreprise[]

  @@unique([tel, entrepriseId])
  @@unique([email, entrepriseId])
}

model UserEntreprise {
  id           Int        @id @default(autoincrement())
  userId       Int
  entrepriseId Int
  roleId       Int?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id])
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id])
  role         Role?      @relation(fields: [roleId], references: [id])

  @@unique([userId, entrepriseId])
}

model Role {
  id           Int          @id @default(autoincrement())
  name         String
  description  String?
  entrepriseId Int?
  entreprise   Entreprise?  @relation(fields: [entrepriseId], references: [id])
  users        User[]
  permissions  Permission[] @relation("RolesOnPermissions")
  userEntreprises UserEntreprise[]

  @@unique([name, entrepriseId])
}

model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  description String?
  roles       Role[]  @relation("RolesOnPermissions")
}

// ─────────────────────────────────────────────
// EMPLOYÉS
// ─────────────────────────────────────────────

model Employe {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @unique
  salaire               Float
  dateEmbauche          DateTime
  user                  User                   @relation(fields: [userId], references: [id])
  absences              Absence[]
  conges                Conge[]
  paiements             SalairePaiement[]
  approvisionnements    Approvisionnement[]
  commandes             Commande[]
  livraisons            Livraison[]
  productions           Production[]
  transferts            TransfertStock[]
  sessionsInventaire    SessionInventaire[]
  historiquesInventaire HistoriqueInventaire[]
}

model Absence {
  id        Int      @id @default(autoincrement())
  motif     String
  date      DateTime
  employeId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employe   Employe  @relation(fields: [employeId], references: [id])
}

model Conge {
  id          Int      @id @default(autoincrement())
  type        String
  dateDebut   DateTime
  dateFin     DateTime
  statut      String
  description String
  employeId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  employe     Employe  @relation(fields: [employeId], references: [id])
}

model SalairePaiement {
  id           Int           @id @default(autoincrement())
  montant      Float
  datePaiement DateTime
  modePaiement String
  periode      DateTime?
  avantage     Float         @default(0)
  indemnite    Float         @default(0)
  employeId    Int
  employe      Employe       @relation(fields: [employeId], references: [id])
  transactions Transaction[]
}

// ─────────────────────────────────────────────
// PRODUITS & STOCK
// ─────────────────────────────────────────────

model Produit {
  id                      Int                      @id @default(autoincrement())
  libelle                 String
  description             String?
  image                   String?
  prixDeVenteUnitaire     Float
  prixAchatUnitaire       Float
  entrepriseId            Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  entreprise              Entreprise?              @relation(fields: [entrepriseId], references: [id])
  stockMagasin            StockMagasin?
  stockBoutique           StockBoutique?
  transferts              TransfertStock[]
  lignesApprovisionnement LigneApprovisionnement[] @relation("ProduitLignesAppro")
  lignesCommande          LigneCommande[]
  productions             Production[]
  historiquesInventaire   HistoriqueInventaire[]
  lots                    LotStock[]

  @@index([libelle])
}

model StockMagasin {
  id                      Int                      @id @default(autoincrement())
  produitId               Int                      @unique
  quantite                Int                      @default(0)
  seuilAlerte             Int                      @default(10)
  updatedAt               DateTime                 @updatedAt
  produit                 Produit                  @relation(fields: [produitId], references: [id])
  lignesApprovisionnement LigneApprovisionnement[]
  productions             Production[]
  transferts              TransfertStock[]         @relation("TransfertDepuisMagasin")
  historiquesInventaire   HistoriqueInventaire[]
}

model StockBoutique {
  id                    Int                    @id @default(autoincrement())
  produitId             Int                    @unique
  quantite              Int                    @default(0)
  seuilAlerte           Int                    @default(5)
  updatedAt             DateTime               @updatedAt
  produit               Produit                @relation(fields: [produitId], references: [id])
  lignesCommande        LigneCommande[]
  transferts            TransfertStock[]       @relation("TransfertDepuisBoutique")
  historiquesInventaire HistoriqueInventaire[]
}

model TransfertStock {
  id              Int            @id @default(autoincrement())
  quantite        Int
  sens            SensTransfert
  motif           String?
  dateTransfert   DateTime       @default(now())
  produitId       Int
  employeId       Int
  stockMagasinId  Int?
  stockBoutiqueId Int?
  entrepriseId    Int?
  produit         Produit        @relation(fields: [produitId], references: [id])
  employe         Employe        @relation(fields: [employeId], references: [id])
  stockMagasin    StockMagasin?  @relation("TransfertDepuisMagasin", fields: [stockMagasinId], references: [id])
  stockBoutique   StockBoutique? @relation("TransfertDepuisBoutique", fields: [stockBoutiqueId], references: [id])
  entreprise      Entreprise?    @relation(fields: [entrepriseId], references: [id])
  transactions    Transaction[]

  @@index([produitId])
}

// ─────────────────────────────────────────────
// INVENTAIRE
// ─────────────────────────────────────────────

model SessionInventaire {
  id           Int                     @id @default(autoincrement())
  dateDebut    DateTime                @default(now())
  dateFin      DateTime?
  statut       SessionInventaireStatut @default(EN_COURS)
  lieu         LieuStock
  commentaire  String?
  employeId    Int
  entrepriseId Int?
  employe      Employe                 @relation(fields: [employeId], references: [id])
  entreprise   Entreprise?             @relation(fields: [entrepriseId], references: [id])
  lignes       HistoriqueInventaire[]
}

model HistoriqueInventaire {
  id                  Int                @id @default(autoincrement())
  dateInventaire      DateTime           @default(now())
  lieuInventaire      LieuStock
  quantiteTheorique   Int
  quantitePhysique    Int
  ecart               Int
  commentaire         String?
  produitId           Int
  employeId           Int
  sessionInventaireId Int?
  stockMagasinId      Int?
  stockBoutiqueId     Int?
  produit             Produit            @relation(fields: [produitId], references: [id])
  employe             Employe            @relation(fields: [employeId], references: [id])
  session             SessionInventaire? @relation(fields: [sessionInventaireId], references: [id])
  stockMagasin        StockMagasin?      @relation(fields: [stockMagasinId], references: [id])
  stockBoutique       StockBoutique?     @relation(fields: [stockBoutiqueId], references: [id])

  @@unique([sessionInventaireId, produitId, lieuInventaire])
}

// ─────────────────────────────────────────────
// COMMANDES & VENTES
// ─────────────────────────────────────────────

model Commande {
  id           Int             @id @default(autoincrement())
  dateCommande DateTime        @default(now())
  montant      Float
  reduction    Float           @default(0)
  statut       CommandeStatut  @default(EN_ATTENTE)
  lieu         LieuStock       @default(BOUTIQUE)
  clientId     Int
  vendeurId    Int?
  entrepriseId Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  client       User            @relation(fields: [clientId], references: [id])
  vendeur      Employe?        @relation(fields: [vendeurId], references: [id])
  entreprise   Entreprise?     @relation(fields: [entrepriseId], references: [id])
  lignes       LigneCommande[]
  paiements    Paiement[]
  livraisons   Livraison[]
  transactions Transaction[]

  @@index([lieu])
}

model LigneCommande {
  id               Int            @id @default(autoincrement())
  quantiteCommande Int
  prixUnitaire     Float
  montant          Float
  coutRevient      Float?
  commandeId       Int
  produitId        Int
  stockBoutiqueId  Int?
  commande         Commande       @relation(fields: [commandeId], references: [id])
  produit          Produit        @relation(fields: [produitId], references: [id])
  stockBoutique    StockBoutique? @relation(fields: [stockBoutiqueId], references: [id])
}

model Paiement {
  id           Int            @id @default(autoincrement())
  montant      Float
  creance      Float          @default(0)
  datePaiement DateTime       @default(now())
  statut       PaiementStatut @default(EN_ATTENTE)
  modePaiement ModePaiement
  commandeId   Int
  commande     Commande       @relation(fields: [commandeId], references: [id])
}

model Livraison {
  id            Int             @id @default(autoincrement())
  adresse       String
  dateLivraison DateTime        @default(now())
  statut        LivraisonStatut @default(EN_ATTENTE)
  commandeId    Int
  livreurId     Int?
  commande      Commande        @relation(fields: [commandeId], references: [id])
  livreur       Employe?        @relation(fields: [livreurId], references: [id])
}

// ─────────────────────────────────────────────
// APPROVISIONNEMENT
// ─────────────────────────────────────────────

model Fournisseur {
  id                 Int                 @id @default(autoincrement())
  nom                String
  prenom             String
  email              String?
  tel                String
  adresse            String
  entrepriseId       Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  entreprise         Entreprise?         @relation(fields: [entrepriseId], references: [id])
  approvisionnements Approvisionnement[]

  @@unique([tel, entrepriseId])
}

model Approvisionnement {
  id                    Int                      @id @default(autoincrement())
  dateApprovisionnement DateTime
  montant               Float
  lieu                  LieuStock                @default(MAGASIN)
  fournisseurId         Int
  employeId             Int
  entrepriseId          Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  fournisseur           Fournisseur              @relation(fields: [fournisseurId], references: [id])
  employe               Employe                  @relation(fields: [employeId], references: [id])
  entreprise            Entreprise?              @relation(fields: [entrepriseId], references: [id])
  lignes                LigneApprovisionnement[]
  transactions          Transaction[]

  @@index([lieu])
}

model LigneApprovisionnement {
  id                  Int               @id @default(autoincrement())
  quantite            Int
  prixUnitaire        Float
  montant             Float
  dateFabrication     DateTime?
  datePeremption      DateTime?
  approvisionnementId Int
  produitId           Int?
  matierePremiereId   Int?
  stockMagasinId      Int?
  approvisionnement   Approvisionnement @relation(fields: [approvisionnementId], references: [id])
  produit             Produit?          @relation("ProduitLignesAppro", fields: [produitId], references: [id])
  matierePremiere     MatierePremiere?  @relation("MatierePremiereLignesAppro", fields: [matierePremiereId], references: [id])
  stockMagasin        StockMagasin?     @relation(fields: [stockMagasinId], references: [id])
  lot                 LotStock?
}

model LotStock {
  id                      Int                     @id @default(autoincrement())
  produitId               Int
  quantiteInitiale        Int
  quantiteRestante        Int
  prixAchat               Float
  dateAppro               DateTime                @default(now())
  ligneApprovisionnementId Int                    @unique
  produit                 Produit                 @relation(fields: [produitId], references: [id])
  ligneApprovisionnement  LigneApprovisionnement  @relation(fields: [ligneApprovisionnementId], references: [id])

  @@index([produitId, dateAppro])
}

// ─────────────────────────────────────────────
// PRODUCTION
// ─────────────────────────────────────────────

model Production {
  id                Int                           @id @default(autoincrement())
  quantiteFabriquee Int
  dateProduction    DateTime                      @default(now())
  lot               String?
  produitId         Int
  employeId         Int
  stockMagasinId    Int?
  produit           Produit                       @relation(fields: [produitId], references: [id])
  employe           Employe                       @relation(fields: [employeId], references: [id])
  stockMagasin      StockMagasin?                 @relation(fields: [stockMagasinId], references: [id])
  consommations     MatierePremiereConsommation[]
}

model MatierePremiere {
  id                      Int                           @id @default(autoincrement())
  nom                     String
  categorie               String?
  description             String?
  quantiteStock           Int                           @default(0)
  prixAchat               Float
  entrepriseId            Int?
  entreprise              Entreprise?                   @relation(fields: [entrepriseId], references: [id])
  lignesApprovisionnement LigneApprovisionnement[]      @relation("MatierePremiereLignesAppro")
  consommations           MatierePremiereConsommation[]
}

model MatierePremiereConsommation {
  id                Int             @id @default(autoincrement())
  quantite          Int
  productionId      Int
  matierePremiereId Int
  production        Production      @relation(fields: [productionId], references: [id])
  matierePremiere   MatierePremiere @relation(fields: [matierePremiereId], references: [id])
}

// ─────────────────────────────────────────────
// FINANCE
// ─────────────────────────────────────────────

model Transaction {
  id                  Int                @id @default(autoincrement())
  type                String
  libelle             String
  montant             Float
  date                DateTime           @default(now())
  entrepriseId        Int?
  commandeId          Int?
  approvisionnementId Int?
  salairePaiementId   Int?
  transfertStockId    Int?
  entreprise          Entreprise?        @relation(fields: [entrepriseId], references: [id])
  commande            Commande?          @relation(fields: [commandeId], references: [id])
  approvisionnement   Approvisionnement? @relation(fields: [approvisionnementId], references: [id])
  salairePaiement     SalairePaiement?   @relation(fields: [salairePaiementId], references: [id])
  transfertStock      TransfertStock?    @relation(fields: [transfertStockId], references: [id])
}

// ─────────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────────

model Contact {
  id           Int           @id @default(autoincrement())
  nom          String
  email        String
  sujet        String
  message      String
  statut       ContactStatut @default(NON_LU)
  entrepriseId Int?
  dateEnvoi    DateTime      @default(now())
  reponse      String?
  dateReponse  DateTime?
  entreprise   Entreprise?   @relation(fields: [entrepriseId], references: [id])
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum SensTransfert {
  MAGASIN_VERS_BOUTIQUE
  BOUTIQUE_VERS_MAGASIN
}

enum LieuStock {
  MAGASIN
  BOUTIQUE
}

enum SessionInventaireStatut {
  EN_COURS
  TERMINE
  VALIDE
  ANNULE
}

enum CommandeStatut {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  PRETE
  LIVREE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  CARTE_BANCAIRE
  MOBILE_MONEY
  ORANGE_MONEY
  MOOV_MONEY
  FLOOZ
  T_MONEY
  MONERO
  AUTRE
}

enum PaiementStatut {
  EN_ATTENTE
  REUSSI
  ECHEC
  ANNULE
}

enum LivraisonStatut {
  EN_ATTENTE
  EN_COURS
  LIVREE
  ECHEC
}

enum ContactStatut {
  NON_LU
  LU
  TRAITE
  ARCHIVE
}
